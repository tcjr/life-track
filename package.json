{
  "name": "life-track-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for life-track applications and services",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter '*' run build",
    "lint": "pnpm --filter '*' run lint",
    "test": "pnpm --filter=web-app run test",
    "start": "echo \"Run start:emulators or start:web-app\"",
    "start:emulators": "firebase emulators:start --only auth,firestore,functions --import=./firebase-dev-data --export-on-exit",
    "start:web-app": "pnpm --filter=web-app run start",
    "deploy-rules": "firebase deploy --only firestore:rules",
    "deploy-functions": "pnpm --filter=functions run deploy"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.31.0",
      "@types/node": "25.5.0"
    }
  }
}
