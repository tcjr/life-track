{
  "name": "web-app",
  "version": "0.0.0",
  "private": true,
  "description": "Simple app to track a few things",
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#components/*": "./app/components/*",
    "#models/*": "./app/models/*",
    "#resources/*": "./app/resources/*",
    "#services/*": "./app/services/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite dev --host -- --clearScreen false",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "^12.8.0",
    "timepicker-ui": "^4.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.1",
    "@ember/test-waiters": "^4.1.1",
    "@embroider/compat": "^4.1.14",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.4",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.0",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.6.0",
    "@eslint/js": "^9.39.2",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.1.1",
    "@glint/template": "^1.7.3",
    "@glint/tsserver-plugin": "^2.0.9",
    "@rollup/plugin-babel": "^6.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@types/rsvp": "^4.0.9",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-webdriverio": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "decorator-transforms": "^2.3.1",
    "ember-cli": "~6.11.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-flash": "^7.0.0",
    "ember-concurrency": "^5.2.0",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-primitives": "^0.53.1",
    "ember-resolver": "^13.2.0",
    "ember-resources": "^7.0.7",
    "ember-source": "~6.11.0",
    "ember-template-lint": "^7.9.3",
    "ember-vitest": "^0.3.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.23.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.0",
    "prettier-plugin-ember-template-tag": "^2.1.2",
    "reactiveweb": "^1.9.1",
    "stylelint": "^17.2.0",
    "stylelint-config-standard": "^40.0.0",
    "svg2ember": "^1.0.0",
    "tailwindcss": "^4.2.1",
    "testem": "^3.17.0",
    "testing-library-ember": "^1.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6",
    "zod-firebase": "^2.1.2"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  }
}
